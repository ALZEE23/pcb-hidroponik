### KiCad project ignores ###

# Lock files (created while a project file is open in KiCad)
*.lck

# Auto-backup files created by KiCad
*.bak
*.000
_autosave-*
*-save.pro
*-save.kicad_pro

# Backup archives KiCad creates on save
*-backups/
_backups/

# Per-user local project settings (layer visibility, hidden nets, etc.)
# Different for every machine, safe to ignore.
*.kicad_prl

# Netlist / BOM / fabrication output (regenerated, not source)
*.net
*-BOM.csv
*-bom.csv
/gerbers/
/plot/
/production/

# ERC / DRC reports (regenerated, not source)
*.rpt

# VSCode "Local History" extension
.history/

# OS / editor cruft
.DS_Store
Thumbs.db
